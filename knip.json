{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server/index.ts",
    "src/client/index.ts",
    "src/ui/index.ts",
    "demo/app.ts",
    "scripts/*.js",
    "tests/**/*.test.ts"
  ],
  "project": ["demo/**/*.ts", "src/**/*.ts", "scripts/*.js", "tests/**/*.ts"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
